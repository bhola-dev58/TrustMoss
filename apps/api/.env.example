# TrustMoss API Environment Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Moss Retrieval Engine Configuration
MOSS_API_KEY=your_moss_api_key_here
MOSS_API_URL=https://api.moss.example.com

# LiveKit Voice & Video Gateway Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Data-at-Rest Encryption (AES-256-GCM, 32-byte base64 or 64-char hex)
ENCRYPTION_KEY=your_32_byte_base64_or_hex_encryption_key_here
