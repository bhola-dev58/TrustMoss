# TrustMoss API Environment Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Moss Retrieval Engine Configuration
MOSS_API_KEY=your_moss_api_key_here
MOSS_API_URL=https://api.moss.example.com

# LiveKit Voice & Video Gateway Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Data-at-Rest Encryption (AES-256-GCM, 32-byte base64 or 64-char hex)
ENCRYPTION_KEY=your_32_byte_base64_or_hex_encryption_key_here

# GDPR Data Lifecycle & TTL Retention Policy (in seconds)
RETENTION_TRANSCRIPTS_TTL_SEC=604800  # 7 days for audio transcripts
RETENTION_AUDIT_TTL_SEC=2592000       # 30 days for PII and audit logs
RETENTION_HITL_TTL_SEC=7776000        # 90 days for HITL review records

# ── Secrets Management (Phase 8) ────────────────────────────────
# SECRET_PROVIDER controls where secrets are fetched from.
# Options: env (default) | vault | aws
# Leave as 'env' for local development with .env file.
# Set to 'vault' when running with docker compose + Vault service.
SECRET_PROVIDER=env

# HashiCorp Vault (only needed when SECRET_PROVIDER=vault)
VAULT_ADDR=http://localhost:8200          # Use http://vault:8200 inside Docker
VAULT_TOKEN=dev-root-token               # Dev mode only — use AppRole in production
VAULT_SECRET_PATH=trustmoss              # KV v2 path: secret/trustmoss
VAULT_MOUNT=secret                       # KV engine mount point

# AWS Secrets Manager (only needed when SECRET_PROVIDER=aws)
AWS_SECRET_NAME=trustmoss/production    # Secret name in AWS Secrets Manager
AWS_REGION=us-east-1                    # AWS region where the secret is stored

# ── Database & Cache Layer (Phase 9) ────────────────────────────
POSTGRES_DSN=postgresql://trustmoss:trustmoss@localhost:5432/trustmoss
POSTGRES_USER=trustmoss
POSTGRES_PASSWORD=trustmoss
POSTGRES_DB=trustmoss
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
SESSION_TTL_SECONDS=7200
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_WINDOW_SEC=300
