# ─────────────────────────────────────────────────────────
# TrustMoss — Root Environment Configuration
# Copy this file to .env and fill in your real values.
# The .env file is gitignored and NEVER committed.
# ─────────────────────────────────────────────────────────

# ── Ports (change to avoid conflicts on your machine) ────
API_PORT=8000
WEB_PORT=3000

# ── Log level for API container ──────────────────────────
LOG_LEVEL=info

# ── Frontend API URL (what the browser calls) ────────────
VITE_API_URL=http://localhost:8000

# ── Firebase Authentication (Web App SDK) ────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=trustmoss-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=trustmoss-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=trustmoss-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=200968222318
NEXT_PUBLIC_FIREBASE_APP_ID=1:200968222318:web:...
